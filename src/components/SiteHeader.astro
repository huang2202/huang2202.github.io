---
import config from '@/site-config'
---

<header>
  <a class='name' href='/'>{config.author}</a>
  <nav aria-label='Primary navigation'>
    {(config.header.menu ?? []).map(({ title, link }) => <a href={link}>{title}</a>)}
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    border-bottom: 1px solid #e4e8ee;
    padding: 24px 0;
    margin-bottom: 36px;
  }
  .name {
    font-size: 17px;
    font-weight: 600;
    color: #283444;
  }
  nav {
    display: flex;
    gap: 24px;
    font-size: 14px;
  }
  a {
    text-decoration: none;
  }
  a:focus-visible {
    outline: 2px solid #173f6b;
    outline-offset: 4px;
  }
</style>
