---
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'

const posts = sortMDByDate(await getBlogCollection())
const meta = { title: 'Writing', description: 'Published writing by Guangyu Huang.' }
---

<PageLayout {meta}>
  <main class='py-4'>
    <h1 class='text-3xl font-medium'>Writing</h1>
    {
      posts.length ? (
        <ul class='mt-8 flex flex-col gap-y-4'>
          {posts.map((post) => (
            <PostPreview {post} detailed />
          ))}
        </ul>
      ) : (
        <p class='mt-6 text-muted-foreground'>There is no published writing at present.</p>
      )
    }
  </main>
</PageLayout>
